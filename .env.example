# Names only. Set real values in Vercel > Settings > Environment Variables. Never commit secrets.
# Resend API key. REQUIRED, or messages are silently discarded (mock mode).
RESEND_API_KEY=
# Recipient. Default risheeknawka@gmail.com; with the test sender it must equal the Resend signup email.
CONTACT_TO=
# Sender, e.g. Portfolio <contact@yourdomain.com>. Default is Resend's test sender.
CONTACT_FROM=
# Long random string for contact time-trap tokens (recommended).
CONTACT_SIGNING_SECRET=
# Upstash Redis REST URL (visit counters).
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token (visit counters).
UPSTASH_REDIS_REST_TOKEN=
# 32+ random characters; enables GET /api/stats.
STATS_TOKEN=
# Extra allowed origins, comma-separated.
ALLOWED_ORIGINS=
